+TEST_F(AXPlatformNodeAuraLinuxTest, TestAtkTextGetSelectionUnicodeOffsets) {
+  const char kText[] = "a\xf0\x9f\x99\x82 caf\xc3\xa9 omega";
+  AXTreeUpdate update = BuildTextField();
+  update.nodes[0].SetValue(kText);
+  Init(update);
+  AtkObject* object = GetRootAtkObject();
+  ASSERT_TRUE(ATK_IS_TEXT(object));
+  AtkText* text = ATK_TEXT(object);
+  EXPECT_EQ(13, atk_text_get_character_count(text));
+
+  const struct {
+    int anchor;
+    int focus;
+    int start;
+    int end;
+    const char* value;
+  } cases[] = {
+      {0, 13, 0, 13, kText},
+      {2, 13, 2, 13, " caf\xc3\xa9 omega"},
+      {1, 2, 1, 2, "\xf0\x9f\x99\x82"},
+      {13, 2, 2, 13, " caf\xc3\xa9 omega"},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.anchor);
+    SCOPED_TRACE(test.focus);
+    ASSERT_TRUE(atk_text_set_selection(text, 0, test.anchor, test.focus));
+    int start = -1;
+    int end = -1;
+    gchar* selected = atk_text_get_selection(text, 0, &start, &end);
+    EXPECT_EQ(test.start, start);
+    EXPECT_EQ(test.end, end);
+    EXPECT_STREQ(test.value, selected);
+    g_free(selected);
+  }
+}
+
+TEST_F(AXPlatformNodeAuraLinuxTest, TestAtkTextGetSelectionBmpUnicodeOffsets) {
+  const struct {
+    const char* value;
+    int count;
+  } cases[] = {
+      {"a plain omega", 13},
+      {"a caf\xc3\xa9 omega", 12},
+      // A combining mark has its own code-point offset.
+      {"a e\xcc\x81 omega", 10},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.value);
+    AXTreeUpdate update = BuildTextField();
+    update.nodes[0].SetValue(test.value);
+    Init(update);
+    AtkText* text = ATK_TEXT(GetRootAtkObject());
+    ASSERT_TRUE(ATK_IS_TEXT(text));
+    EXPECT_EQ(test.count, atk_text_get_character_count(text));
+    ASSERT_TRUE(atk_text_set_selection(text, 0, 0, test.count));
+    int start = -1;
+    int end = -1;
+    gchar* selected = atk_text_get_selection(text, 0, &start, &end);
+    EXPECT_EQ(0, start);
+    EXPECT_EQ(test.count, end);
+    EXPECT_STREQ(test.value, selected);
+    g_free(selected);
+  }
+}
