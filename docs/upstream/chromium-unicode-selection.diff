+TEST_F(AXPlatformNodeAuraLinuxTest, TestAtkTextFindInPageUnicodeOffsets) {
+  const char kText[] = "a\xf0\x9f\x99\x82 caf\xc3\xa9 omega";
+  AXNodeData document;
+  document.id = 1;
+  document.role = ax::mojom::Role::kRootWebArea;
+  document.child_ids = {2};
+  AXNodeData content;
+  content.id = 2;
+  content.role = ax::mojom::Role::kStaticText;
+  content.SetName(kText);
+  AXTreeUpdate update;
+  update.root_id = document.id;
+  update.nodes = {document, content};
+  Init(update);
+  AtkObject* object = GetRootAtkObject();
+  ASSERT_TRUE(ATK_IS_TEXT(object));
+  AtkText* text = ATK_TEXT(object);
+  EXPECT_EQ(13, atk_text_get_character_count(text));
+
+  // Find-in-page stores UTF-16 offsets, unlike GetSelectionExtents().
+  const struct {
+    int utf16_start;
+    int utf16_end;
+    int start;
+    int end;
+    const char* value;
+  } cases[] = {
+      {0, 14, 0, 13, kText},
+      {3, 14, 2, 13, " caf\xc3\xa9 omega"},
+      {1, 3, 1, 2, "\xf0\x9f\x99\x82"},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.utf16_start);
+    SCOPED_TRACE(test.utf16_end);
+    GetRootPlatformNode()->ActivateFindInPageResult(test.utf16_start,
+                                                    test.utf16_end);
+    EXPECT_EQ(1, atk_text_get_n_selections(text));
+    int start = -1;
+    int end = -1;
+    gchar* selected = atk_text_get_selection(text, 0, &start, &end);
+    EXPECT_EQ(test.start, start);
+    EXPECT_EQ(test.end, end);
+    EXPECT_STREQ(test.value, selected);
+    g_free(selected);
+  }
+  GetRootPlatformNode()->TerminateFindInPage();
+  EXPECT_EQ(0, atk_text_get_n_selections(text));
+  int start = -1;
+  int end = -1;
+  gchar* selected = atk_text_get_selection(text, 0, &start, &end);
+  EXPECT_EQ(0, start);
+  EXPECT_EQ(0, end);
+  EXPECT_EQ(nullptr, selected);
+  g_free(selected);
+}
